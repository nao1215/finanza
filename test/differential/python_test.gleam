//// Differential test against Python's `decimal`.
////
//// `test/differential/python_cases.gleam` is generated by
//// `scripts/python_differential.py`: random and boundary inputs to the
//// decimal operations and to every interest function, with the text
//// Python's `decimal` gives at 200 digits (and, for interest, exact
//// fractions), after the range rules of `finanza/decimal`. Every case
//// must give the same text here, on both targets.

import gleam/int
import gleam/list
import gleam/order
import gleam/string

import differential/python_cases.{type DecimalCase, type InterestCase}
import finanza/decimal
import finanza/interest

fn mode(name: String) -> decimal.RoundingMode {
  case name {
    "HalfUp" -> decimal.HalfUp
    "HalfDown" -> decimal.HalfDown
    "Up" -> decimal.Up
    "Down" -> decimal.Down
    "Ceiling" -> decimal.Ceiling
    "Floor" -> decimal.Floor
    _ -> decimal.HalfEven
  }
}

// An operand as text, or zero for an unused one. An operand that does
// not parse is a failure of its own, so it is not replaced by a value.
fn value(text: String) -> Result(decimal.Decimal, Nil) {
  case text, decimal.parse(text) {
    "", _ -> Ok(decimal.zero())
    _, Ok(value) -> Ok(value)
    _, Error(_) -> Error(Nil)
  }
}

fn with_operands(
  a: String,
  b: String,
  run: fn(decimal.Decimal, decimal.Decimal) -> String,
) -> String {
  case value(a), value(b) {
    Ok(a), Ok(b) -> run(a, b)
    _, _ -> "!OperandDoesNotParse"
  }
}

fn arithmetic(result: Result(decimal.Decimal, decimal.ArithmeticError)) {
  case result {
    Ok(value) -> decimal.to_string(value)
    Error(decimal.PrecisionExceeded) -> "!PrecisionExceeded"
    Error(decimal.DivisionByZero) -> "!DivisionByZero"
  }
}

fn parsed(result: Result(decimal.Decimal, decimal.ParseError)) -> String {
  case result {
    Ok(value) -> decimal.to_string(value)
    Error(decimal.ParsedValueTooLarge) -> "!ParsedValueTooLarge"
    Error(decimal.InputTooLong) -> "!InputTooLong"
    Error(_) -> "!Invalid"
  }
}

fn order_name(value: order.Order) -> String {
  case value {
    order.Lt -> "Lt"
    order.Eq -> "Eq"
    order.Gt -> "Gt"
  }
}

fn run_decimal(case_: DecimalCase) -> String {
  case case_.operation {
    "parse" -> parsed(decimal.parse(case_.a))
    _ ->
      with_operands(case_.a, case_.b, fn(a, b) { run_decimal_on(case_, a, b) })
  }
}

fn run_decimal_on(case_: DecimalCase, a: decimal.Decimal, b: decimal.Decimal) {
  case case_.operation {
    "to_string" -> decimal.to_string(a)
    "add" -> arithmetic(decimal.add(a, b))
    "subtract" -> arithmetic(decimal.subtract(a, b))
    "multiply" -> arithmetic(decimal.multiply(a, b))
    "divide" ->
      arithmetic(decimal.divide(
        a,
        b,
        digits: case_.digits,
        rounding: mode(case_.mode),
      ))
    "round" ->
      arithmetic(decimal.round(
        a,
        digits: case_.digits,
        rounding: mode(case_.mode),
      ))
    "compare" -> order_name(decimal.compare(a, b))
    _ -> "!UnknownOperation"
  }
}

fn interest_error(error: interest.InterestError) -> String {
  case error {
    interest.NegativePrincipal -> "!NegativePrincipal"
    interest.RateBelowMinusOne -> "!RateBelowMinusOne"
    interest.PeriodsOutOfRange -> "!PeriodsOutOfRange"
    interest.CompoundsOutOfRange -> "!CompoundsOutOfRange"
    interest.DigitsOutOfRange -> "!DigitsOutOfRange"
    interest.ArithmeticFailed(decimal.PrecisionExceeded) ->
      "!ArithmeticFailed(PrecisionExceeded)"
    interest.ArithmeticFailed(decimal.DivisionByZero) ->
      "!ArithmeticFailed(DivisionByZero)"
  }
}

fn interest_value(result: Result(decimal.Decimal, interest.InterestError)) {
  case result {
    Ok(value) -> decimal.to_string(value)
    Error(error) -> interest_error(error)
  }
}

fn rows(result: Result(List(interest.Period), interest.InterestError)) {
  case result {
    Ok(periods) ->
      periods
      |> list.map(fn(row) {
        [row.payment, row.interest, row.principal_paid, row.balance]
        |> list.map(decimal.to_string)
        |> string.join(",")
      })
      |> string.join(";")
    Error(error) -> interest_error(error)
  }
}

fn run_interest(case_: InterestCase) -> String {
  with_operands(case_.a, case_.b, fn(a, b) { run_interest_on(case_, a, b) })
}

fn run_interest_on(
  case_: InterestCase,
  a: decimal.Decimal,
  b: decimal.Decimal,
) -> String {
  let periods = case_.periods
  let digits = case_.digits
  case case_.operation {
    "simple" ->
      interest_value(interest.simple(principal: a, rate: b, periods:, digits:))
    "future_value" ->
      interest_value(interest.future_value(
        present: a,
        rate_per_period: b,
        periods:,
        digits:,
      ))
    "present_value" ->
      interest_value(interest.present_value(
        future: a,
        rate_per_period: b,
        periods:,
        digits:,
      ))
    "payment" ->
      interest_value(interest.payment(
        principal: a,
        rate_per_period: b,
        periods:,
        digits:,
      ))
    "effective_annual_rate" ->
      interest_value(interest.effective_annual_rate(
        nominal_rate: a,
        compounds_per_year: periods,
        digits:,
      ))
    "schedule" ->
      rows(interest.schedule(
        principal: a,
        rate_per_period: b,
        periods:,
        digits:,
      ))
    "schedule_head" ->
      rows(interest.schedule(
        principal: a,
        rate_per_period: b,
        periods:,
        digits:,
      ))
      |> string.split(";")
      |> list.take(3)
      |> string.join(";")
    _ -> "!UnknownOperation"
  }
}

fn describe(mismatches: List(String)) -> String {
  int.to_string(list.length(mismatches))
  <> " mismatches, first: "
  <> string.join(list.take(mismatches, 10), "\n")
}

pub fn decimal_operations_match_python_test() {
  let mismatches =
    python_cases.decimal_cases()
    |> list.filter_map(fn(case_) {
      let actual = run_decimal(case_)
      case actual == case_.expected {
        True -> Error(Nil)
        False ->
          Ok(
            case_.operation
            <> "("
            <> case_.a
            <> ", "
            <> case_.b
            <> ", "
            <> int.to_string(case_.digits)
            <> ", "
            <> case_.mode
            <> "): expected "
            <> case_.expected
            <> ", got "
            <> actual,
          )
      }
    })
  assert describe(mismatches) == describe([])
}

pub fn interest_functions_match_python_test() {
  let mismatches =
    python_cases.interest_cases()
    |> list.filter_map(fn(case_) {
      let actual = run_interest(case_)
      case actual == case_.expected {
        True -> Error(Nil)
        False ->
          Ok(
            case_.operation
            <> "("
            <> case_.a
            <> ", "
            <> case_.b
            <> ", "
            <> int.to_string(case_.periods)
            <> ", "
            <> int.to_string(case_.digits)
            <> "): expected "
            <> string.slice(case_.expected, 0, 200)
            <> ", got "
            <> string.slice(actual, 0, 200),
          )
      }
    })
  assert describe(mismatches) == describe([])
}
